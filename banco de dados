CREATE EXTENSION IF NOT EXISTS "pgcrypto";

-- =====================================================
-- USERS
-- =====================================================

CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    name VARCHAR(120) NOT NULL,

    email VARCHAR(255) NOT NULL UNIQUE,

    password_hash VARCHAR(255) NOT NULL,

    phone VARCHAR(20),

    role VARCHAR(30) NOT NULL DEFAULT 'CUSTOMER',

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT ck_users_role
        CHECK (role IN ('CUSTOMER', 'WORKSHOP_OWNER', 'MECHANIC', 'ADMIN'))
);

CREATE INDEX idx_users_email
    ON users(email);


-- =====================================================
-- MOTORCYCLES
-- =====================================================

CREATE TABLE motorcycles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    user_id UUID NOT NULL,

    brand VARCHAR(80) NOT NULL,

    model VARCHAR(80) NOT NULL,

    year SMALLINT NOT NULL,

    plate VARCHAR(10) UNIQUE,

    mileage INTEGER NOT NULL DEFAULT 0,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_motorcycles_user
        FOREIGN KEY (user_id)
        REFERENCES users(id)
        ON DELETE CASCADE,

    CONSTRAINT ck_motorcycles_year
        CHECK (year BETWEEN 1900 AND 2100),

    CONSTRAINT ck_motorcycles_mileage
        CHECK (mileage >= 0)
);

CREATE INDEX idx_motorcycles_user_id
    ON motorcycles(user_id);


-- =====================================================
-- WORKSHOPS
-- =====================================================

CREATE TABLE workshops (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    owner_id UUID NOT NULL,

    name VARCHAR(150) NOT NULL,

    description TEXT,

    phone VARCHAR(20),

    email VARCHAR(255),

    address VARCHAR(255),

    city VARCHAR(100),

    state CHAR(2),

    zip_code VARCHAR(10),

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_workshops_owner
        FOREIGN KEY (owner_id)
        REFERENCES users(id)
);

CREATE INDEX idx_workshops_owner_id
    ON workshops(owner_id);

CREATE INDEX idx_workshops_city_state
    ON workshops(city, state);


-- =====================================================
-- SERVICES
-- =====================================================

CREATE TABLE services (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    workshop_id UUID NOT NULL,

    name VARCHAR(120) NOT NULL,

    description TEXT,

    base_price NUMERIC(12,2) NOT NULL,

    estimated_duration_minutes INTEGER NOT NULL,

    active BOOLEAN NOT NULL DEFAULT TRUE,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_services_workshop
        FOREIGN KEY (workshop_id)
        REFERENCES workshops(id)
        ON DELETE CASCADE,

    CONSTRAINT ck_services_price
        CHECK (base_price >= 0),

    CONSTRAINT ck_services_duration
        CHECK (estimated_duration_minutes > 0)
);

CREATE INDEX idx_services_workshop_id
    ON services(workshop_id);

CREATE INDEX idx_services_active
    ON services(active);


-- =====================================================
-- APPOINTMENTS
-- =====================================================

CREATE TABLE appointments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    customer_id UUID NOT NULL,

    motorcycle_id UUID NOT NULL,

    workshop_id UUID NOT NULL,

    service_id UUID NOT NULL,

    scheduled_at TIMESTAMPTZ NOT NULL,

    status VARCHAR(30) NOT NULL DEFAULT 'PENDING',

    notes TEXT,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_appointments_customer
        FOREIGN KEY (customer_id)
        REFERENCES users(id),

    CONSTRAINT fk_appointments_motorcycle
        FOREIGN KEY (motorcycle_id)
        REFERENCES motorcycles(id),

    CONSTRAINT fk_appointments_workshop
        FOREIGN KEY (workshop_id)
        REFERENCES workshops(id),

    CONSTRAINT fk_appointments_service
        FOREIGN KEY (service_id)
        REFERENCES services(id),

    CONSTRAINT ck_appointments_status
        CHECK (
            status IN (
                'PENDING',
                'CONFIRMED',
                'IN_PROGRESS',
                'COMPLETED',
                'CANCELLED'
            )
        )
);

CREATE INDEX idx_appointments_customer_id
    ON appointments(customer_id);

CREATE INDEX idx_appointments_workshop_id
    ON appointments(workshop_id);

CREATE INDEX idx_appointments_scheduled_at
    ON appointments(scheduled_at);

CREATE INDEX idx_appointments_status
    ON appointments(status);


-- =====================================================
-- QUOTES
-- =====================================================

CREATE TABLE quotes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    appointment_id UUID NOT NULL UNIQUE,

    total_amount NUMERIC(12,2) NOT NULL,

    description TEXT,

    status VARCHAR(30) NOT NULL DEFAULT 'PENDING',

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_quotes_appointment
        FOREIGN KEY (appointment_id)
        REFERENCES appointments(id)
        ON DELETE CASCADE,

    CONSTRAINT ck_quotes_amount
        CHECK (total_amount >= 0),

    CONSTRAINT ck_quotes_status
        CHECK (
            status IN (
                'PENDING',
                'APPROVED',
                'REJECTED',
                'EXPIRED'
            )
        )
);

CREATE INDEX idx_quotes_status
    ON quotes(status);


-- =====================================================
-- SERVICE ORDERS
-- =====================================================

CREATE TABLE service_orders (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    quote_id UUID NOT NULL UNIQUE,

    status VARCHAR(30) NOT NULL DEFAULT 'OPEN',

    started_at TIMESTAMPTZ,

    finished_at TIMESTAMPTZ,

    notes TEXT,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_service_orders_quote
        FOREIGN KEY (quote_id)
        REFERENCES quotes(id),

    CONSTRAINT ck_service_orders_status
        CHECK (
            status IN (
                'OPEN',
                'IN_PROGRESS',
                'WAITING_PAYMENT',
                'COMPLETED',
                'CANCELLED'
            )
        )
);


-- =====================================================
-- PAYMENTS
-- =====================================================

CREATE TABLE payments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    service_order_id UUID NOT NULL,

    amount NUMERIC(12,2) NOT NULL,

    payment_method VARCHAR(30) NOT NULL,

    status VARCHAR(30) NOT NULL DEFAULT 'PENDING',

    transaction_id VARCHAR(255),

    paid_at TIMESTAMPTZ,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_payments_service_order
        FOREIGN KEY (service_order_id)
        REFERENCES service_orders(id),

    CONSTRAINT ck_payments_amount
        CHECK (amount > 0),

    CONSTRAINT ck_payments_method
        CHECK (
            payment_method IN (
                'PIX',
                'CREDIT_CARD',
                'DEBIT_CARD'
            )
        ),

    CONSTRAINT ck_payments_status
        CHECK (
            status IN (
                'PENDING',
                'AUTHORIZED',
                'PAID',
                'FAILED',
                'REFUNDED',
                'CANCELLED'
            )
        )
);

CREATE INDEX idx_payments_service_order_id
    ON payments(service_order_id);

CREATE INDEX idx_payments_transaction_id
    ON payments(transaction_id);


-- =====================================================
-- REVIEWS
-- =====================================================

CREATE TABLE reviews (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    customer_id UUID NOT NULL,

    workshop_id UUID NOT NULL,

    service_order_id UUID NOT NULL UNIQUE,

    rating SMALLINT NOT NULL,

    comment TEXT,

    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT fk_reviews_customer
        FOREIGN KEY (customer_id)
        REFERENCES users(id),

    CONSTRAINT fk_reviews_workshop
        FOREIGN KEY (workshop_id)
        REFERENCES workshops(id),

    CONSTRAINT fk_reviews_service_order
        FOREIGN KEY (service_order_id)
        REFERENCES service_orders(id),

    CONSTRAINT ck_reviews_rating
        CHECK (rating BETWEEN 1 AND 5)
);

CREATE INDEX idx_reviews_workshop_id
    ON reviews(workshop_id);
